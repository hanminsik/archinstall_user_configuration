    "archinstall_language": "English",
    "auth_config": {},
    "bootloader_config": {
        "bootloader": "Systemd-boot",
        "removable": false,
        "uki": true
    },
    "custom_commands": [
        "pacman -Rns --noconfirm htop",
        "pacman -S --noconfirm xdg-user-dirs",
        "runuser -u minsik -- env HOME=/home/minsik LC_ALL=C.UTF-8 xdg-user-dirs-update --force",
        "printf '%s\\n' 'GTK_IM_MODULE=fcitx' 'QT_IM_MODULE=fcitx' 'QT4_IM_MODULE=fcitx' 'QT5_IM_MODULE=fcitx' 'XMODIFIERS=@im=fcitx' >> /etc/environment",
        "systemctl enable paccache.timer",
        "install -d -o minsik -g minsik /home/minsik/yay-build",
        "printf '%s\\n' '#!/bin/bash' 'set -eu' 'cd /home/minsik/yay-build' 'if [ ! -d yay/.git ]; then runuser -u minsik -- git clone https://aur.archlinux.org/yay.git yay; fi' 'chown -R minsik:minsik yay' 'cd yay' 'runuser -u minsik -- makepkg --syncdeps --noconfirm' 'pacman -U --noconfirm ./yay-*.pkg.tar.zst' 'cd /' 'rm -rf /home/minsik/yay-build' > /usr/local/bin/install-yay-minsik",
        "chmod 755 /usr/local/bin/install-yay-minsik",
        "printf '%s\\n' '[Unit]' 'Description=Build and install yay for minsik' 'Wants=network-online.target' 'After=network-online.target' '' '[Service]' 'Type=oneshot' 'ExecStart=/usr/local/bin/install-yay-minsik' 'ExecStartPost=/usr/bin/systemctl disable yay-autoinstall.service' '' '[Install]' 'WantedBy=multi-user.target' > /etc/systemd/system/yay-autoinstall.service",
        "systemctl enable yay-autoinstall.service",
        "flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo",
        "printf '%s\\n' '#!/bin/bash' 'set -eu' 'flatpak install --system --noninteractive flathub com.todoist.Todoist' 'flatpak install --system --noninteractive flathub io.github.Qalculate' > /usr/local/bin/install-todoist",
        "chmod 755 /usr/local/bin/install-todoist",
        "printf '%s\\n' '[Unit]' 'Description=Install Todoist and Qalculate Flatpaks' 'Wants=network-online.target' 'After=network-online.target' '' '[Service]' 'Type=oneshot' 'ExecStart=/usr/local/bin/install-todoist' 'ExecStartPost=/usr/bin/systemctl disable todoist-autoinstall.service' '' '[Install]' 'WantedBy=multi-user.target' > /etc/systemd/system/todoist-autoinstall.service",
        "systemctl enable todoist-autoinstall.service",
        "systemctl enable bluetooth.service",
        "printf '%s\\n' 'rw quiet mitigations=off' > /etc/kernel/cmdline"
    ],
