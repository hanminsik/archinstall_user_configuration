{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        },
        "bluetooth_config": {
            "enabled": true
        },
        "firewall_config": {
            "firewall": "ufw"
        },
        "fonts_config": {
            "fonts": [
                "noto-fonts-emoji",
                "noto-fonts-cjk"
            ]
        },
        "print_service_config": {
            "enabled": false
        }
